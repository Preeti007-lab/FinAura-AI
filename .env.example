# FinAura AI - Production Environment Variables
# Copy these into Vercel Environment Variables or Render Environment Variables

# 1. MongoDB Database URI (MongoDB Atlas or Cloud Instance)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/finaura_db?retryWrites=true&w=majority

# 2. Groq AI API Key (For fast Llama-3 AI inference)
GROQ_API_KEY=gsk_your_groq_api_key_here

# 3. Clerk Authentication Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# 4. Server Port & Environment
PORT=5000
NODE_ENV=production
